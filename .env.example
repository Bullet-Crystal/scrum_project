# Local environment example. Copy to .env and export the variables
# (or configure them in your shell / IDE) before starting the application.

DB_URL=jdbc:mysql://localhost:3306/scrumweb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# Must be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
